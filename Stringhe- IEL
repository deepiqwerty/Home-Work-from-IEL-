package lezione01_Intro;

public class Stringhe {

	public static void main(String[] args) {
		//Le stringhe non sono del tipi primitivi, sono un tipo complesso, parliama già di oggetti
		String mioNome = "Deepi";
		
		int numeroLettere = mioNome.length();
		
		System.out.println("Il mio nome è composto da " + numeroLettere + " caratteri");
		
//		// Le stringhe sono oggeti 0-based
		String nomeCorso = "Technico sviluppo Siti Web";
		int numCaratteri = nomeCorso.length(); //Att: Vengono inclusi anche gli spazi nel conteggio
		System.out.println("Lunghezza stringa" + numCaratteri + " caratteri");
		
		char primaLettera = nomeCorso.charAt(0);
		System.out.println("In prima posizione si trova la lettera" + primaLettera);
		
		// 
		char ultimaLettura = nomeCorso.charAt(nomeCorso.length()-1);
		
		//Ricerca parola
		boolean trovata = nomeCorso.contains("Tecn");
		System.out.println("La stringa contiene la parola cercata:" + trovata);
		
		int posizione = nomeCorso.indexOf("Siti");
		System.out.println("La parola Siti trova in posizione " + posizione);
		
		int posizioneLettera2= nomeCorso.indexOf("e");
		System.out.println("La lettura e si trova in posizione ultima " + posizioneLettera2);
		
		//taglia String 
		String parziale = nomeCorso.substring(5,10);
		System.out.println("Stringa parziale: " + parziale);
		
		System.out.println(nomeCorso.toUpperCase());
		System.out.println(nomeCorso.toLowerCase());
		
		String pezzo1 = "Andiamo in";
		String pezzo2 = "Pausa!";
		String finale = pezzo1.concat(" ").concat(pezzo2);
		
		System.out.println(finale.toUpperCase());
		
		//Posso creare una stringha utilizzando la notazione con new 
		String s1 = new String("Ciao questa è una stringa");
		
		System.out.println(s1);
		System.out.println(s1.charAt(2));
		
		//Come confronte 2 stringhe 
		String s2 = "Ciao"; //definizione letterale --> mmeorizza nello String Pool
		String s3 = new String("Ciao"); //definizione con costruttore --> memrizza nella memoria heap
		
		boolean conf1 = s2.contentEquals(s3); //.equals() confronta i contenutti
		System.out.println("Le due stringhe sono uguali ?" + conf1 );
		
		boolean conf2 = (s2==s3); // == confronta i riferimenti, Quindi confronta duw slot diversi di memoria 
		
		System.out.println("Le due stringhe sono uguali ?" + conf2);
		
		String s4 = "Ciao";
		boolean conf3 = (s2 == s4); // true perche s2 e s4 arrivano dallo stesso String pool
		System.out.println("Le due stringhe sono uguali ?" + conf3);
		
		String s5 = new String("Ciao");
		boolean conf4 = (s5 == s3);
		System.out.println(conf4); // false perchè s5 e s3 pur essendo state create con new appartengono a due diversi indirizzo di memoria
		boolean conf5 = s5.equals(s3);
		System.out.println(conf5); //true perchè s5 e s3 hanno lo stesso contenuto
		
		String s6 = "Ciao";
		String s7 = "Miao";
		boolean conf6 = s6 == s7; //false perche legge il contenuto dallo stesso Stringpool
		System.out.println(conf6);
			
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		

		
		
		
		
		
				
		
		
		
		

	}

}
